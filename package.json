{
  "name": "shred-scout",
  "version": "1.0.0",
  "description": "Agentic terminal UI for finding compatible snowboard gear deals across multiple retailers",
  "type": "module",
  "bin": {
    "shred-scout": "./bin/shred-scout"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "react": "18.3.1",
    "@types/react": "^18.3.28"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "6.8.0",
    "react": "18.3.1",
    "@anthropic-ai/sdk": "0.91.1",
    "undici": "8.1.0",
    "conf": "15.1.0",
    "better-sqlite3": "12.9.0",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.28",
    "tsx": "^4.21.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.5",
    "execa": "^9.6.1",
    "@biomejs/biome": "^2.4.13"
  }
}
