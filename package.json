{
  "name": "shred-scout",
  "version": "1.0.0",
  "description": "Agentic terminal UI for finding compatible snowboard gear deals across multiple retailers",
  "type": "module",
  "bin": {
    "shred-scout": "./bin/shred-scout"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "react": "19.1.0",
    "@types/react": "^19.1.5"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "setup": "npm run build && npm link",
    "start": "node bin/shred-scout search",
    "demo": "node dist/cli.js --demo",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "better-sqlite3": "12.9.0",
    "cheerio": "^1.0.0",
    "commander": "14.0.3",
    "conf": "15.1.0",
    "ink": "6.8.0",
    "p-queue": "9.2.0",
    "p-retry": "8.0.0",
    "react": "19.1.0",
    "terminal-image": "4.3.0",
    "undici": "8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.5",
    "execa": "^9.6.1",
    "ink-testing-library": "4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.5"
  }
}
